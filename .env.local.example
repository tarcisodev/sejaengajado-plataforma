# Copie para `.env.local` na raiz e rode: node scripts/dev-auth.mjs init
# `.env.local` fica FORA do git. Nunca coloque secrets de produção aqui.
# Nunca aponte SUPABASE_URL para auth.sejaengajado.com.br no localhost.

# Gerado por `init` se vazio (32+ bytes aleatórios).
SUPABASE_JWT_SECRET=

# JWTs HS256 longos (role anon / service_role) — gerados por `init`.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do GoTrue local (gateway nginx).
SUPABASE_URL=http://localhost:9999
SUPABASE_JWT_AUD=authenticated

# Admin de desenvolvimento (seed-admin).
DEV_ADMIN_EMAIL=tarcisojun@gmail.com
