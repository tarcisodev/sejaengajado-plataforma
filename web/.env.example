# Placeholders only — never commit real secrets.

# Empty apiUrl → mock ApiPort (dev). Production SSR uses same-origin /api.
API_BASE_URL=
# Used by HttpApiService when not empty (see environments).
# Production: relative /api via Traefik PathPrefix on app.sejaengajado.com.br

# Public GoTrue/Supabase (anon) — never service_role.
# Local: gerado em web/public/se-public-config.json por `node scripts/dev-auth.mjs init`
# (http://localhost:9999). Nunca auth.sejaengajado.com.br no localhost.
# Production: env on web-ssr → /se-public-config.json
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional local Places key (production uses API /places/search; leave empty).
GOOGLE_PLACES_API_KEY=

# Sentry — production: SENTRY_DSN_FILE=/run/secrets/se_sentry_dsn (SSR); browser via /se-public-config.json
SENTRY_DSN=
SENTRY_DSN_FILE=
SENTRY_RELEASE=
