    "@spartan-ng/brain": "^1.6.3",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^4.18.2",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
