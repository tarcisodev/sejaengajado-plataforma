    "e2e:fluxo-feliz": "playwright test e2e/fluxo-feliz",
    "e2e:fluxo-feliz:smoke": "playwright test e2e/fluxo-feliz --grep @smoke",
    "e2e:publico:prod": "node scripts/e2e-publico-prod.mjs"
  },
  "private": true,
  "overrides": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
