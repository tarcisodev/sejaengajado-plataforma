generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  RESELLER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ResellerStatus {
  ACTIVE
  DELINQUENT
  BLOCKED
}

enum SiteStatus {
  DRAFT
  PUBLISHED
  READ_ONLY
  SUSPENDED
  ARCHIVED
}

enum PlanType {
  ONE_TIME
  RECURRING
  ANNUAL_HOSTING
}

enum CouponType {
  PCT
  FIXED
}

enum PaymentMethod {
  PIX
  CARD
  BOLETO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PlaqueType {
  QR
  NFC
}

enum PlaqueStatus {
  STOCK
  DELIVERED
}

enum ProductCode {
  SITE_ONE_TIME
  SITE_PRO
  PLAQUE_QR
  PLAQUE_NFC
  RENEWAL
}

enum SaleStatus {
  RECORDED
  VOIDED
}

enum LedgerType {
  IN
  OUT
}

enum LedgerCategory {
  SALE
  PLATFORM_INVOICE
  PLAQUE_PURCHASE
  MANUAL
  REVERSAL
}

enum PlaqueMovementType {
  IN
  OUT
  ADJUST
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
}

model User {
  id         String     @id @default(uuid()) @db.Uuid
  supabaseId String     @unique @map("supabase_id")
  email      String     @unique
  role       UserRole
  resellerId String?    @map("reseller_id") @db.Uuid
  status     UserStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)
  customer Customer?

  @@index([resellerId])
  @@map("users")
}

model ResellerPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  monthlyFeeCents Int      @map("monthly_fee_cents")
  siteLimit       Int?     @map("site_limit")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  resellers Reseller[]

  @@map("reseller_plans")
}

model Reseller {
  id                String         @id @default(uuid()) @db.Uuid
  name              String
  status            ResellerStatus @default(ACTIVE)
  resellerPlanId    String         @map("reseller_plan_id") @db.Uuid
  isPlatform        Boolean        @default(false) @map("is_platform")
  gatewayCustomerId String?        @map("gateway_customer_id")
  delinquentSince   DateTime?      @map("delinquent_since") @db.Timestamptz(3)
  blockedAt         DateTime?      @map("blocked_at") @db.Timestamptz(3)
  blockedReason     String?        @map("blocked_reason")
  blockedById       String?        @map("blocked_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan             ResellerPlan      @relation(fields: [resellerPlanId], references: [id])
  users            User[]
  customers        Customer[]
  sites            Site[]
  wholesalePrices  WholesalePrice[]
  resellerPrices   ResellerPrice[]
  sales            Sale[]
  ledgerEntries    LedgerEntry[]
  plaqueMovements  PlaqueMovement[]
  invoices         ResellerInvoice[]
  lifecycleEvents  LifecycleEvent[]
  jobEmailLogs     JobEmailLog[]
  plaques          Plaque[]

  @@index([status])
  @@map("resellers")
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  resellerId String   @map("reseller_id") @db.Uuid
  name       String
  doc        String   @default("")
  whatsapp   String   @default("")
  city       String   @default("")
  /** Login e-mail for direct (platform) customers — optional for reseller CRM rows. */
  email      String?  @unique
  userId     String?  @unique @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller @relation(fields: [resellerId], references: [id])
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sites    Site[]

  @@index([resellerId])
  @@map("customers")
}

model Template {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  name       String
  niche      String
  schemaType String   @map("schema_type")
  schema     Json     @default("{}")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sites Site[]

  @@map("templates")
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  type        PlanType
  priceCents  Int      @map("price_cents")
  interval    String?
  features    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sites         Site[]
  orders        Order[]
  subscriptions Subscription[]

  @@map("plans")
}

model Site {
  id                   String     @id @default(uuid()) @db.Uuid
  resellerId           String     @map("reseller_id") @db.Uuid
  customerId           String     @map("customer_id") @db.Uuid
  slug                 String
  templateId           String     @map("template_id") @db.Uuid
  planId               String     @map("plan_id") @db.Uuid
  status               SiteStatus @default(DRAFT)
  editable             Boolean    @default(false)
  content              Json       @default("{}")
  publishedAt          DateTime?  @map("published_at") @db.Timestamptz(3)
  hostingRenewsAt      DateTime?  @map("hosting_renews_at") @db.Timestamptz(3)
  plaqueFidelityEndsAt DateTime?  @map("plaque_fidelity_ends_at") @db.Timestamptz(3)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller        Reseller         @relation(fields: [resellerId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  template        Template         @relation(fields: [templateId], references: [id])
  plan            Plan             @relation(fields: [planId], references: [id])
  plaques         Plaque[]
  scanEvents      ScanEvent[]
  plaqueMovements PlaqueMovement[]
  lifecycleEvents LifecycleEvent[]
  subscriptions   Subscription[]

  @@index([resellerId])
  @@index([customerId])
  @@map("sites")
}

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  type            CouponType
  value           Int
  active          Boolean    @default(true)
  validFrom       DateTime?  @map("valid_from") @db.Timestamptz(3)
  validTo         DateTime?  @map("valid_to") @db.Timestamptz(3)
  maxUses         Int?       @map("max_uses")
  usedCount       Int        @default(0) @map("used_count")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@map("coupons")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  resellerId  String?     @map("reseller_id") @db.Uuid
  planId      String      @map("plan_id") @db.Uuid
  couponId    String?     @map("coupon_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  amountCents Int         @map("amount_cents")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan    Plan     @relation(fields: [planId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])
  payment Payment?

  @@index([resellerId])
  @@map("orders")
}

model Subscription {
  id               String             @id @default(uuid()) @db.Uuid
  resellerId       String?            @map("reseller_id") @db.Uuid
  siteId           String?            @map("site_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime           @map("current_period_end") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan Plan  @relation(fields: [planId], references: [id])
  site Site? @relation(fields: [siteId], references: [id])

  @@index([resellerId])
  @@index([siteId])
  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid()) @db.Uuid
  orderId          String        @unique @map("order_id") @db.Uuid
  resellerId       String?       @map("reseller_id") @db.Uuid
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amountCents      Int           @map("amount_cents")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([resellerId])
  @@map("payments")
}

model WebhookEvent {
  id          String        @id @default(uuid()) @db.Uuid
  gateway     String
  eventId     String        @map("event_id")
  status      WebhookStatus @default(RECEIVED)
  attempts    Int           @default(0)
  payload     Json          @default("{}")
  lastError   String?       @map("last_error")
  processedAt DateTime?     @map("processed_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([gateway, eventId])
  @@map("webhook_events")
}

model Plaque {
  id         String       @id @default(uuid()) @db.Uuid
  resellerId String       @map("reseller_id") @db.Uuid
  siteId     String?      @map("site_id") @db.Uuid
  type       PlaqueType
  status     PlaqueStatus @default(STOCK)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller @relation(fields: [resellerId], references: [id])
  site     Site?    @relation(fields: [siteId], references: [id])

  @@index([resellerId])
  @@map("plaques")
}

model ScanEvent {
  id         String   @id @default(uuid()) @db.Uuid
  siteId     String   @map("site_id") @db.Uuid
  ipHash     String   @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId, createdAt])
  @@map("scan_events")
}

model ReservedSlug {
  slug      String   @id
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("reserved_slugs")
}

model PlatformConfig {
  id                 String   @id @default("default")
  warningDays        Int      @default(7) @map("warning_days")
  readOnlyDays       Int      @default(8) @map("read_only_days")
  suspendDays        Int      @default(16) @map("suspend_days")
  archiveDays        Int      @default(60) @map("archive_days")
  resellerGraceDays  Int      @default(30) @map("reseller_grace_days")
  prontoRenewalCents Int      @map("pronto_renewal_cents")
  plaqueValueCents   Int      @map("plaque_value_cents")
  plaquePenaltyPct   Int      @map("plaque_penalty_pct")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_config")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  role      String
  action    String
  entity    String
  entityId  String   @map("entity_id")
  diff      Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Product {
  id                 String      @id @default(uuid()) @db.Uuid
  code               ProductCode @unique
  name               String
  baseWholesaleCents Int         @map("base_wholesale_cents")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  wholesalePrices WholesalePrice[]
  resellerPrices  ResellerPrice[]
  saleItems       SaleItem[]
  invoiceLines    InvoiceLine[]

  @@map("products")
}

model WholesalePrice {
  id         String    @id @default(uuid()) @db.Uuid
  resellerId String    @map("reseller_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  priceCents Int       @map("price_cents")
  validFrom  DateTime  @map("valid_from") @db.Timestamptz(3)
  validTo    DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reseller  Reseller   @relation(fields: [resellerId], references: [id])
  product   Product    @relation(fields: [productId], references: [id])
  saleItems SaleItem[]

  @@index([resellerId, productId])
  @@map("wholesale_prices")
}

model ResellerPrice {
  id         String   @id @default(uuid()) @db.Uuid
  resellerId String   @map("reseller_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  priceCents Int      @map("price_cents")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller @relation(fields: [resellerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([resellerId, productId])
  @@map("reseller_prices")
}

model Sale {
  id             String     @id @default(uuid()) @db.Uuid
  resellerId     String     @map("reseller_id") @db.Uuid
  status         SaleStatus @default(RECORDED)
  idempotencyKey String     @map("idempotency_key")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller   @relation(fields: [resellerId], references: [id])
  items    SaleItem[]

  @@unique([resellerId, idempotencyKey])
  @@index([resellerId, createdAt])
  @@map("sales")
}

model SaleItem {
  id               String @id @default(uuid()) @db.Uuid
  saleId           String @map("sale_id") @db.Uuid
  productId        String @map("product_id") @db.Uuid
  wholesalePriceId String? @map("wholesale_price_id") @db.Uuid
  qty              Int
  unitCostCents    Int    @map("unit_cost_cents")
  unitPriceCents   Int    @map("unit_price_cents")

  sale           Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  wholesalePrice WholesalePrice? @relation(fields: [wholesalePriceId], references: [id])
  plaqueMovements PlaqueMovement[]

  @@index([saleId])
  @@map("sale_items")
}

model LedgerEntry {
  id           String         @id @default(uuid()) @db.Uuid
  resellerId   String         @map("reseller_id") @db.Uuid
  type         LedgerType
  category     LedgerCategory
  amountCents  Int            @map("amount_cents")
  refType      String?        @map("ref_type")
  refId        String?        @map("ref_id")
  reversalOfId String?        @unique @map("reversal_of_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  reseller   Reseller     @relation(fields: [resellerId], references: [id])
  reversalOf LedgerEntry? @relation("LedgerReversal", fields: [reversalOfId], references: [id])
  reversals  LedgerEntry[] @relation("LedgerReversal")

  @@index([resellerId, createdAt])
  @@map("ledger_entries")
}

model PlaqueMovement {
  id            String             @id @default(uuid()) @db.Uuid
  resellerId    String             @map("reseller_id") @db.Uuid
  type          PlaqueMovementType
  plaqueType    PlaqueType         @map("plaque_type")
  qty           Int
  unitCostCents Int?               @map("unit_cost_cents")
  siteId        String?            @map("site_id") @db.Uuid
  saleItemId    String?            @map("sale_item_id") @db.Uuid
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  reseller Reseller  @relation(fields: [resellerId], references: [id])
  site     Site?     @relation(fields: [siteId], references: [id])
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id])

  @@index([resellerId, plaqueType])
  @@map("plaque_movements")
}

model ResellerInvoice {
  id               String        @id @default(uuid()) @db.Uuid
  resellerId       String        @map("reseller_id") @db.Uuid
  period           String
  status           InvoiceStatus @default(DRAFT)
  totalCents       Int           @default(0) @map("total_cents")
  gatewayPaymentId String?       @unique @map("gateway_payment_id")
  dueDate          DateTime?     @map("due_date") @db.Timestamptz(3)
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  reseller Reseller      @relation(fields: [resellerId], references: [id])
  lines    InvoiceLine[]

  @@unique([resellerId, period])
  @@map("reseller_invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String
  qty         Int     @default(1)
  unitCents   Int     @map("unit_cents")
  totalCents  Int     @map("total_cents")

  invoice ResellerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

model LifecycleEvent {
  id           String   @id @default(uuid()) @db.Uuid
  resellerId   String?  @map("reseller_id") @db.Uuid
  siteId       String?  @map("site_id") @db.Uuid
  fromStatus   String   @map("from_status")
  toStatus     String   @map("to_status")
  reason       String
  penaltyCents Int?     @map("penalty_cents")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reseller Reseller? @relation(fields: [resellerId], references: [id])
  site     Site?     @relation(fields: [siteId], references: [id])

  @@index([resellerId, createdAt])
  @@index([siteId, createdAt])
  @@map("lifecycle_events")
}

/** Persisted dedupe for job e-mails: at most one per reseller + band + SP day. */
model JobEmailLog {
  id         String   @id @default(uuid()) @db.Uuid
  resellerId String   @map("reseller_id") @db.Uuid
  band       String
  localDate  String   @map("local_date")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reseller Reseller @relation(fields: [resellerId], references: [id])

  @@unique([resellerId, band, localDate])
  @@index([localDate])
  @@map("job_email_logs")
}
