# Placeholders only — never commit real secrets. Production: Docker secrets (*_FILE).

NODE_ENV=development
PORT=3000

# App role (se_app, FORCE RLS). Production: DATABASE_URL_FILE=/run/secrets/se_database_url
DATABASE_URL=postgresql://se_app:se_app@127.0.0.1:5432/sejaengajado
# Admin role (se_admin, BYPASSRLS). Production: ADMIN_DATABASE_URL_FILE=/run/secrets/se_admin_database_url
ADMIN_DATABASE_URL=postgresql://se_admin:se_admin@127.0.0.1:5432/sejaengajado

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_AUD=authenticated
# Production: SUPABASE_JWT_SECRET_FILE=/run/secrets/se_supabase_jwt_secret
SUPABASE_JWT_SECRET_FILE=
# Production: SUPABASE_SERVICE_ROLE_KEY_FILE=/run/secrets/se_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY_FILE=

# Production: SMTP_URL_FILE=/run/secrets/se_smtp_url
SMTP_URL_FILE=

# Asaas — chave só via *_FILE (nunca no repo). Sandbox local:
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY_FILE=
ASAAS_WEBHOOK_TOKEN_FILE=

# Cloudflare R2 (S3-compatible)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=se-uploads
S3_BACKUP_BUCKET=se-backup
S3_ACCESS_KEY_FILE=/run/secrets/se_s3_access_key_v1
S3_SECRET_KEY_FILE=/run/secrets/se_s3_secret_key_v1

# Production: SENTRY_DSN_FILE=/run/secrets/se_sentry_dsn
SENTRY_DSN=
SENTRY_DSN_FILE=

GOOGLE_PLACES_API_KEY=
# Production: GOOGLE_PLACES_API_KEY_FILE=

# Heartbeat jobs — Production: HC_JOBS_URL_FILE=/run/secrets/se_hc_jobs_url
HC_JOBS_URL=
HC_JOBS_URL_FILE=

# OpenAPI (/api/docs). Default false; always off when NODE_ENV=production.
ENABLE_DOCS=false
