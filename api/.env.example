DATABASE_URL=
ADMIN_DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET_FILE=
SUPABASE_JWT_AUD=authenticated
SUPABASE_SERVICE_ROLE_KEY_FILE=
SMTP_URL_FILE=
# Asaas sandbox — chave só via secret file (nunca no repo / logs).
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY_FILE=/run/secrets/se_asaas_api_key_v1
ASAAS_WEBHOOK_TOKEN_FILE=/run/secrets/se_asaas_webhook_token_v1
# Cloudflare R2 (S3-compatible). Endpoint sem valor real no example.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=se-uploads
S3_BACKUP_BUCKET=se-backup
S3_ACCESS_KEY_FILE=/run/secrets/se_s3_access_key_v1
S3_SECRET_KEY_FILE=/run/secrets/se_s3_secret_key_v1
SENTRY_DSN=
GOOGLE_PLACES_API_KEY=
# Em produção use GOOGLE_PLACES_API_KEY_FILE= apontando para o Docker secret.
# Heartbeat dos jobs (Docker secret se_hc_jobs_url): HC_JOBS_URL_FILE=
HC_JOBS_URL=
# OpenAPI (/api/docs). Default false; sempre off em NODE_ENV=production.
ENABLE_DOCS=false
