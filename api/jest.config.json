{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testPathIgnorePatterns": ["/node_modules/", "\\.int-spec\\.ts$", "/test/e2e/"],
  "testRegex": ".*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "testEnvironment": "node",
  "collectCoverageFrom": [
    "src/auth/auth.context.ts",
    "src/auth/roles.guard.ts",
    "src/auth/supabase-jwt.guard.ts",
    "src/ledger/ledger.service.ts",
    "src/stock/stock.service.ts",
    "src/sales/sales.service.ts",
    "src/jobs/penalty.ts",
    "src/jobs/overdue-days.ts",
    "src/tenant/tenant.context.ts",
    "!**/*.spec.ts"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov"],
  "coverageThreshold": {
    "global": {
      "statements": 90,
      "branches": 80,
      "functions": 90,
      "lines": 90
    }
  }
}
